{
  "mcpServers": {
    "rmm-roblox-mod-ai": {
      "command": "python",
      "args": [
        "-m",
        "roblox_mod_ai.mcp_server"
      ],
      "env": {
        "ROBLOX_MOD_AI_WORKSPACE": "rmm-output",
        "ROBLOX_MOD_AI_ALLOW_OFFLINE_FALLBACK": "1"
      }
    },
    "roblox-studio-bridge": {
      "command": "npx",
      "args": [
        "-y",
        "robloxstudio-mcp@latest"
      ],
      "env": {
        "PORT": "3000"
      }
    }
  }
}
